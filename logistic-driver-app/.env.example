# ═══════════════════════════════════════════════════════════════════════════════
# Porter Driver App - Environment Variables Template (.env.example)
# Copy this file to .env and fill in your environment values.
# ═══════════════════════════════════════════════════════════════════════════════

# API Base URL (http://10.0.2.2:8081/api for Android Emulator, http://localhost:8081/api for Web/Desktop/iOS)
BASE_URL=http://10.0.2.2:8081/api

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Payment Gateway Key ID
RAZORPAY_KEY_ID=your_razorpay_key_id_here

# Feature Flags & Logging
ENABLE_DEBUG_LOGGING=true
