# ═══════════════════════════════════════════════════════════════════════════════
# Porter Admin App - Environment Variables Template (.env.example)
# Copy this file to .env and fill in your environment values.
# ═══════════════════════════════════════════════════════════════════════════════

# API Base URL (http://localhost:8081/api for Web/Desktop, http://10.0.2.2:8081/api for Android Emulator)
BASE_URL=http://localhost:8081/api

# Firebase API Key
FIREBASE_API_KEY=your_firebase_api_key_here

# Feature Flags & Logging
ENABLE_DEBUG_LOGGING=true
