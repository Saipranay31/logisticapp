# ═══════════════════════════════════════════════════════════════════════════════
# Porter Backend - Environment Variables Template (.env.example)
# Copy this file to .env and configure your values.
# ═══════════════════════════════════════════════════════════════════════════════

# Server Settings
SERVER_PORT=8081

# Database Configuration (PostgreSQL)
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/porter_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication (Min 256-bit secret key required)
JWT_SECRET=your_jwt_secret_key_here_min_256_bits
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# Google Maps API Key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Firebase Push Notifications
FIREBASE_CREDENTIALS=firebase-key.json
